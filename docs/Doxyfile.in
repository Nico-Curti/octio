PROJECT_NAME           = octio
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doxygen
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include @CMAKE_CURRENT_SOURCE_DIR@/src
RECURSIVE              = YES
FILE_PATTERNS           = *.h *.hpp *.cpp
GENERATE_HTML           = YES
GENERATE_LATEX          = NO
QUIET                   = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_STATIC          = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT        = YES
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
